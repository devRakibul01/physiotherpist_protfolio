# Copy to .env and fill in before `npm run build`
VITE_SITE_URL=https://www.your-domain.com
# Optional: Formspree / Web3Forms / any endpoint accepting JSON POST
VITE_FORM_ENDPOINT=
# Optional: Google Analytics 4 measurement ID (loaded only after visitor consent)
VITE_GA4_ID=
# Optional: search engine verification tokens
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
